VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Server-only. Never expose this in the frontend or Cloudflare Worker.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Gemini / Google AI Studio — SERVER-ONLY (proxied via /api/gemini).
# Do NOT prefix with VITE_ or it will be bundled into the public client.
# In production set it as a Cloudflare secret: `wrangler secret put GEMINI_API_KEY`
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
